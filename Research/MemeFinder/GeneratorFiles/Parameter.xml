<?xml version="1.0" ?> 

<class terminator="true"> 

<namespace>NVL_App</namespace> 
<solution>MemeFinderLib</solution> 
<name>Parameters</name> 
<description>Defines a set of generated parameters</description> 

<includes>    
    <include name="iostream" namespace="std" local="false" /> 
    <include name="opencv2/opencv.hpp" namespace="cv" local="false" />
</includes> 

<variables> 
    <variable type="double" name="k1" code="10" />
    <variable type="double" name="k2" code="10" />
    <variable type="double" name="p1" code="10" />
    <variable type="double" name="p2" code="10" />
    <variable type="double" name="cx" code="10" />
    <variable type="double" name="cy" code="10" />
    <variable type="vector<double>" name="activeParams" code="10" /> 
</variables> 

<constructors> 

<!-- Main Constructor -->
<constructor type="custom" inline="false"> 
    <parameter type="const Point2d&" name="center" description="The center point of the image" /> 
</constructor> 

</constructors>    

<methods>    

<!-- Set Value -->
<method section="Update" access="public" return="void" name="SetValue" description="Update a parameter value by index" inline="false"> 
    <parameter type="int" name="index" description="The index of the parameter to set" />
    <parameter type="double" name="value" description="The new value to set" /> 
</method> 

<!-- Get Distortion -->
<method section="Get" access="public" return="Mat" name="GetDistortion" description="Get the current distortion parameters" inline="false" /> 

<!-- Get Center -->
<method section="Get" access="public" return="Point2d" name="GetCenter" description="Get the current center point" inline="false" /> 

</methods> 

</class> 